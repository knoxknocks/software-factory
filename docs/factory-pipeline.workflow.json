      {
        "id": "intake-spec",
        "label": "Intake to spec",
        "focus": [
          "cmd_run",
          "queue",
          "intake",
          "route",
          "spec"
        ],
        "note": "/factory run asks job queue for work; intake decides, route picks reviewers, spec-writer writes acceptance criteria."
      },
      {
        "id": "build-loop",
        "label": "Build, gate, review loop",
        "focus": [
          "builder",
          "gate",
          "reviewers"
        ],
        "note": "Up to max_rounds of build → gate → parallel reviewers. Gate FAIL or any CHANGES returns to the builder."
      },
      {
        "id": "human",
        "label": "Where humans step in",
        "focus": [
          "approver",
          "pr_ready",
          "needs_human",
          "feedback",
          "needs_info"
        ],
        "note": "Approved PRs wait for a human merge; escalations and feedback restart the build with a fresh round budget."
      }
    ]
  },
